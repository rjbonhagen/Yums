# Sample mode is explicit and never enabled as a source-outage fallback.
YUMS_DEMO_MODE=false

# Optional account persistence (public client settings, not service-role keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set true for the invited pilot; also disable new sign-ups in Supabase Auth.
NEXT_PUBLIC_INVITE_ONLY=false

# Hosted HTTPS origin for auth redirects behind AWS/proxies. Localhost needs no value.
APP_ORIGIN=

# Optional map view (public token).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional server-side chat provider.
OPENAI_API_KEY=

# Optional Google Calendar refresh credentials (server only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
